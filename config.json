{
    "FILES": {
        "INPUT_DIR": "./input/2022",
        "OUTPUT_DIR": "./output",
        "DATA_FILE": "Journal.json",
        "PHOTOS_DIR": "photos",
        "OUTPUT_HTML": "journal.html",
        "OUTPUT_COVER_HTML": "cover.html",
        "STYLESHEET": "style.css"
    },
    "ENTRIES": {
        "METADATA": {
            "TAGS": {
                "COLOR": {
                    "MIN_ALPHA": 0.5,
                    "SATURATION": "75%",
                    "LIGHTNESS": "50%"
                }
            },
            "DATE_TIME": {
                "INCLUDE_YEAR": false,
                "COLOR": {
                    "BASE_HUE": 180,
                    "HUE_INCREMENT": -30
                }
            },
            "LOCATIONS": {
                "INCLUDE_COORDINATES": false,
                "SKIP_COUNTRY": "United States"
            }
        },
        "CONTENT": {
            "LOREM_IPSUM_MODE": false
        },
        "IMAGES": {
            "ENABLED": true,
            "RUN_RESIZE": false,
            "MAX_WIDTH": 600,
            "ONLY_BORDERS": false
        }
    },
    "OTHER_CONTENT": {
        "INCLUDE_TAG_INDEX": true,
        "INCLUDE_NEW_DAY_HEADER": false
    },
    "cover": {
        "dimensions": {
            "totalWidthIn": 18.56,
            "heightIn": 11.25,
            "spineWidthIn": 1.31,
            "bleedIn": 0.125
        },
        "typography": {
            "fontFamily": "\"Avenir\", \"Avenir Next\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
            "dateTypography": {
                "year": {
                    "fontSize": "60pt",
                    "fontWeight": 600,
                    "letterSpacing": "0em",
                    "marginBottom": "0.2em"
                },
                "months": {
                    "fontSize": "28pt",
                    "fontWeight": 400,
                    "letterSpacing": "0.06em",
                    "marginBottom": "1.2em"
                }
            },
            "authorTypography": {
                "fontSize": "16pt",
                "fontWeight": 400,
                "letterSpacing": "0.08em"
            },
            "spineSizePt": 16,
            "letterSpacingEm": 0.04
        },
        "colors": {
            "background": "#ffffff",
            "text": "#000000",
            "accent": "#ffffff"
        },
        "content": {
            "showSubtitle": true,
            "subtitle": "Proof of Concept"
        }
    }
}