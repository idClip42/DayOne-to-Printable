{
    "FILES": {
        "INPUT_DIR": "./input/2023-4-30-DayOne",
        "OUTPUT_DIR": "./output",
        "DATA_FILE": "Journal.json",
        "PHOTOS_DIR": "photos",
        "OUTPUT_HTML": "journal.html",
        "OUTPUT_COVER_HTML": "cover.html",
        "STYLESHEET": "style.css"
    },
    "ENTRIES": {
        "METADATA": {
            "TAGS": {
                "COLOR": {
                    "MIN_ALPHA": 0.5,
                    "SATURATION": 0.75,
                    "LIGHTNESS": 0.5
                }
            },
            "DATE_TIME": {
                "INCLUDE_YEAR": false,
                "COLOR": {
                    "BASE_HUE": 180,
                    "HUE_INCREMENT": -30
                }
            },
            "LOCATIONS": {
                "INCLUDE_COORDINATES": false,
                "SKIP_COUNTRY": "United States"
            }
        },
        "CONTENT": {
            "LOREM_IPSUM_MODE": false
        },
        "IMAGES": {
            "ENABLED": true,
            "RUN_RESIZE": false,
            "MAX_WIDTH": 600,
            "ONLY_BORDERS": false
        }
    },
    "OTHER_CONTENT": {
        "INCLUDE_TAG_INDEX": true,
        "INCLUDE_NEW_DAY_HEADER": true
    },
    "cover": {
        "dimensions": {
            "totalWidthIn": 20.688,
            "heightIn": 12.75,
            "spineWidthIn": 1.938,
            "hingeIn": 0.25,
            "bleedIn": 0.125
        },
        "typography": {
            "fontFamily": "\"Avenir\", \"Avenir Next\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
            "dateTypography": {
                "year": {
                    "fontSize": "60pt",
                    "fontWeight": 600,
                    "letterSpacing": "0em",
                    "marginBottom": "0.2em"
                },
                "months": {
                    "fontSize": "28pt",
                    "fontWeight": 400,
                    "letterSpacing": "0.06em",
                    "marginBottom": "1.2em"
                }
            },
            "authorTypography": {
                "fontSize": "16pt",
                "fontWeight": 400,
                "letterSpacing": "0.08em"
            },
            "spineSize": {
                "yearPt": 24,
                "monthsPt": 20
            },
            "letterSpacingEm": 0.04,
            "spineVolumeTypography": {
                "labelSizePt": 8,
                "numberSizePt": 18,
                "letterSpacingEm": 0.08
            }
        },
        "colors": {
            "background": "#2b3a50",
            "text": "#d4d8e0",
            "accent": "#141d28"
        },
        "content": {
            "showSubtitle": false,
            "subtitle": "Proof of Concept",
            "volume": {
                "number": 2
