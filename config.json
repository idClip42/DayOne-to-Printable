{
    "FILES": {
        "INPUT_DIR": "./input",
        "OUTPUT_DIR": "./output",
        "DATA_FILE": "Journal.json",
        "PHOTOS_DIR": "photos",
        "OUTPUT_HTML": "journal.html",
        "STYLESHEET": "style.css"
    },
    "ENTRIES": {
        "METADATA": {
            "TAGS": {
                "COLOR": {
                    "MIN_ALPHA": 0.5,
                    "SATURATION": "75%",
                    "LIGHTNESS": "50%"
                }
            },
            "DATE_TIME": {
                "COLOR": {
                    "BASE_HUE": 180,
                    "HUE_INCREMENT": -30
                }
            },
            "LOCATIONS": {
                "INCLUDE_COORDINATES": false,
                "SKIP_COUNTRY": "United States"
            }
        },
        "CONTENT": {
            "LOREM_IPSUM_MODE": false
        },
        "IMAGES": {
            "ENABLED": true,
            "RUN_RESIZE": false,
            "MAX_WIDTH": 600,
            "ONLY_BORDERS": false
        }
    },
    "OTHER_CONTENT": {
        "INCLUDE_TAG_INDEX": true,
        "INCLUDE_NEW_DAY_HEADER": false
    }
}