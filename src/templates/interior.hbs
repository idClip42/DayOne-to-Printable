{{! 
Prettier formatting gets rid of this, so we have to add it elsewhere.
<!DOCTYPE html> 
}}
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Journal Export</title>

        <style>
            {{style}}
        </style>

        <!-- Bringing in "pagedjs" package -->
        <script src="../node_modules/pagedjs/dist/paged.polyfill.js"></script>
    </head>
    <body>
        <div id="first-page">
            <div style="display: none">
                {{#each colorTestDates}}
                    <div style="background-color: {{this.color}}">
                        {{this.date}}
                    </div>
                {{/each}}
            </div>

            <div id="stats-index" class="stats-group">
                <h2>
                    Stats
                </h2>
                <table class="info-table">
                    {{#each stats}}
                        <tr>
                            <td class="info-table-label">
                                {{this.label}}
                            </td>
                            <td class="info-table-value">
                                {{this.value}}
                            </td>
                        </tr>
                    {{/each}}
                </table>
            </div>

            <div id="tag-index" class="stats-group">
                <h2>
                    Tags
                </h2>
                <table class="info-table">
                    {{#each tagStats}}
                        <tr>
                            <td class="info-table-label">
                                {{this.label}}
                            </td>
                            <td class="info-table-value">
                                {{this.value}}
                            </td>
                        </tr>
                    {{/each}}
                </table>
            </div>
        </div>

        <div id="entries">
            {{#each entriesHtml}}
                {{{this}}}
            {{/each}}
        </div>
    </body>
</html>