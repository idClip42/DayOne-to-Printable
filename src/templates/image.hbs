{{#if obfuscate}}
    {{! Hides image }}
    <div
        class="entry-photo"
        style="border-style: solid; border-color: lightgray;"
    >
        <img {{imgAttributes}} style="opacity: 0" />
    </div>
{{else}}
    {{! Shows image }}
    <div class="entry-photo">
        <img {{imgAttributes}} />
    </div>
{{/if}}