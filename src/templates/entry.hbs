<article class="entry">
    <div
        class="metadata"
        style="background: linear-gradient(to bottom, {{monthColor}}, #ffffff)"
    >
        <p class="pre-date-time">
            <span class="weekday">{{weekday}}</span>
            <span class="weather">{{weather}}</span>
        </p>

        <h2 class="date">
            {{monthDay}}
            ·
            {{time}}
            <span class="am-pm">{{amPm}}</span>
        </h2>

        <div class="hidden-date">
            {{weekday}},
            {{monthDay}},
            {{year}}
        </div>

        <p class="post-date-time">
            <span>{{location}}</span>
        </p>

        <p class="tags">
            Tags:
            {{#each tagHtmls}}
                {{this}}
            {{/each}}
        </p>
    </div>
    <div>
        {{{contentHtml}}}
    </div>
</article>