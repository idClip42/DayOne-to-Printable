<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Journal Cover</title>

        <style>
            {{{css.vars}}}
        </style>

        <style>
            {{{css.style}}}
        </style>
    </head>

    <body>
        <div id="cover">
            <section class="back">
                <!-- intentionally blank for now -->
            </section>

            <section class="spine">
                <div class="spine-title">
                    <span class="year">{{yearText}}</span>
                    <span class="months">: {{monthText}}</span>
                </div>

                <div class="accent"></div>

                <div class="volume">
                    <div class="vol-label">VOL.</div>
                    <div class="vol-number">{{volumeNumber}}</div>
                </div>
            </section>

            <section class="front">
                <div class="year">{{yearText}}</div>
                <div class="months">{{monthText}}</div>
                <div class="author">{{author}}</div>

                {{#with subtitle}}
                    <div class="subtitle">{{subtitle}}</div>
                {{/with}}
            </section>
        </div>
    </body>
</html>`